# 复制为 .env 后修改所有值
# 数据库 root 密码（docker-compose 与裸机部署共用）
DB_PASSWORD=change-me

# 数据库名
DB_NAME=find_good_room

# 对外 HTTP 端口（nginx 监听）
HTTP_PORT=80

# ---- 以下仅裸机部署（deploy-bare.sh）使用 ----
# 安装目录
INSTALL_DIR=/opt/find_good_room
# 是否导入演示数据（26 套房源 + 5 个 demo 房东；会清空房源/非管理员用户）
LOAD_DEMO=0
# nginx server_name：域名或公网 IP
SERVER_NAME=_
# 后端监听端口（仅本机，nginx 反代）
API_PORT=8000
# 数据库连接（MySQL 不在本机时修改）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root

# JWT 签发密钥，随机长字符串
JWT_SECRET=change-me-to-random-string

# 管理员账号（seed 脚本用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
